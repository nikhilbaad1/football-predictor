# Copy to .env and adjust.

# SQLite by default — no infrastructure needed for the week 1-3 slice.
# Switch to Postgres when the RAG layer arrives and pgvector is needed:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/football
DATABASE_URL=sqlite:///data/football.db

# Where downloaded CSVs are cached. Fetch once, reuse forever.
DATA_DIR=data

# --- API keys ---------------------------------------------------------------
# Real keys go in .env, which is gitignored. NEVER in this file: it is committed,
# and a key pasted here reaches GitHub. tests/test_env_example.py fails the build
# if one does.

# Anthropic key, for the entity-resolution agent (ADR 0013).
# Get one at https://console.anthropic.com -> Settings -> API Keys.
# Billed pay-as-you-go, separate from a Claude Pro/Max subscription.
# Nothing else needs it: ingest, backtest, predict, fixtures, fpl, the MCP
# server and lexical retrieval all run without a key.
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI key, for dense retrieval embeddings (PLAN section 13: voyage-3-large).
# Get one at https://dashboard.voyageai.com -> API Keys.
# Only the dense-retrieval step needs it; lexical search runs without one.
VOYAGE_API_KEY=pa-...
